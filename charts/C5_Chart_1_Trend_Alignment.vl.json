{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How Far Apart Are School and University Trends?",
  "title": {
    "text": "How Far Apart Are School and University Trends?",
    "anchor": "start",
    "fontSize": 17,
    "subtitle": ["Change in School and University Enrolments"]
  },

  "width": "container",
  "height": 440,
  "padding": {"left": 10, "right": 20, "top": 10, "bottom": 10},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/aus_senior_enrolments.csv",
    "format": {"parse": {"year": "number", "enrolments": "number"}}
  },

  "params": [
    {
      "name": "start_year",
      "value": 2015,
      "bind": {"input": "range", "min": 2015, "max": 2023, "step": 1, "name": "From year "}
    },
    {
      "name": "end_year",
      "value": 2024,
      "bind": {"input": "range", "min": 2016, "max": 2024, "step": 1, "name": "To year "}
    }
  ],

  "transform": [
    {
      "filter": "datum.year_level === 'Year 11-12 combined' && indexof(['NSW', 'VIC', 'SA', 'WA'], datum.state) >= 0 && indexof(['Computing and IT', 'Physics', 'Chemistry', 'Engineering', 'Business', 'Accounting', 'Economics', 'Visual Arts', 'Music', 'Drama', 'Biology', 'Physical Education', 'Psychology', 'Studies of Religion'], datum.subject_group) >= 0 && (datum.year === start_year || datum.year === end_year)"
    },
    {
      "aggregate": [{"op": "sum", "field": "enrolments", "as": "school_enrolments_nsw_vic_sa_wa"}],
      "groupby": ["subject_group", "year"]
    },
    {"calculate": "datum.subject_group", "as": "school_subject"},
    {
      "calculate": "({'Computing and IT': 'Information Technology', 'Physics': 'Natural and Physical Sciences', 'Chemistry': 'Natural and Physical Sciences', 'Engineering': 'Engineering and Related Technologies', 'Business': 'Management and Commerce', 'Accounting': 'Management and Commerce', 'Economics': 'Management and Commerce', 'Visual Arts': 'Creative Arts', 'Music': 'Creative Arts', 'Drama': 'Creative Arts', 'Biology': 'Health', 'Physical Education': 'Health', 'Psychology': 'Society and Culture', 'Studies of Religion': 'Society and Culture'})[datum.subject_group]",
      "as": "tertiary_field"
    },
    {
      "lookup": "tertiary_field",
      "from": {
        "data": {"url": "data/tertiary_all_students_2015_2024.csv"},
        "key": "Category",
        "fields": ["2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024"]
      }
    },
    {"calculate": "toNumber(datum[toString(datum.year)])", "as": "tertiary_all_students"},
    {
      "calculate": "datum.year === start_year ? datum.school_enrolments_nsw_vic_sa_wa : null",
      "as": "school_at_start"
    },
    {
      "calculate": "datum.year === start_year ? datum.tertiary_all_students : null",
      "as": "tertiary_at_start"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "school_at_start", "as": "school_at_start"},
        {"op": "max", "field": "tertiary_at_start", "as": "tertiary_at_start"}
      ],
      "groupby": ["school_subject"]
    },
    {"filter": "datum.year === end_year"},
    {
      "calculate": "(datum.school_enrolments_nsw_vic_sa_wa / datum.school_at_start - 1) * 100",
      "as": "school_change_pct"
    },
    {
      "calculate": "(datum.tertiary_all_students / datum.tertiary_at_start - 1) * 100",
      "as": "tertiary_change_pct"
    },
    {"calculate": "datum.tertiary_change_pct - datum.school_change_pct", "as": "gap_pp"},
    {"calculate": "datum.school_subject", "as": "row_label"},
    {"fold": ["school_change_pct", "tertiary_change_pct"], "as": ["which", "change_pct"]},
    {
      "calculate": "datum.which === 'school_change_pct' ? 'School students' : 'University students'",
      "as": "level"
    },
    {
      "joinaggregate": [{"op": "min", "field": "change_pct", "as": "row_min"}],
      "groupby": ["school_subject"]
    },
    {
      "calculate": "indexof([\"Computing and IT\", \"Drama\", \"Physics\", \"Engineering\", \"Business\"], datum.school_subject) >= 0 ? (round(datum.change_pct) === 0 ? '0' : format(datum.change_pct, '+.0f')) : ''",
      "as": "value_label"
    }
  ],

  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": "Subjects",
      "sort": {"field": "gap_pp", "op": "mean", "order": "descending"},
      "axis": {
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "ticks": false,
        "domain": false
      }
    }
  },

  "layer": [
    {
      "mark": {"type": "rule", "color": "#1d1c1a", "strokeWidth": 1},
      "encoding": {
        "x": {"datum": 0, "type": "quantitative"},
        "y": {"value": 0},
        "y2": {"value": "height"}
      }
    },
    {
      "mark": {"type": "rule", "color": "#b9b7ae", "strokeWidth": 4},
      "encoding": {
        "x": {"aggregate": "min", "field": "change_pct", "type": "quantitative"},
        "x2": {"aggregate": "max", "field": "change_pct"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "opacity": 1,
        "stroke": "#fbfaf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "change_pct",
          "type": "quantitative",
          "title": "Percentage of change in enrolments",
          "axis": {"format": "+d", "grid": true, "gridColor": "#eeede8"},
          "scale": {"domain": [-45, 190], "nice": false}
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["School students", "University students"],
            "range": ["#6b7b8c", "#14284b"]
          },
          "legend": {"orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "school_subject", "title": "School subject"},
          {"field": "tertiary_field", "title": "University field"},
          {"field": "level", "title": "Level"},
          {"field": "change_pct", "title": "Change (%)", "format": "+.0f"},
          {"field": "gap_pp", "title": "University minus school (pp)", "format": "+.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#1d1c1a",
        "align": {"expr": "datum.change_pct === datum.row_min ? 'right' : 'left'"},
        "dx": {"expr": "datum.change_pct === datum.row_min ? -11 : 11"}
      },
      "encoding": {
        "x": {"field": "change_pct", "type": "quantitative"},
        "text": {"field": "value_label"},
        "color": {"value": "#1d1c1a"}
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Gender Imbalances Across Subjects and States",
  "title": {
    "text": "Gender Imbalances Across Subjects and States",
    "subtitle": [
      "Each dot is a state,",
      "the grey line spans the lowest to the highest state"
    ]
  },
  "width": 560,
  "height": 540,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/national_gender_by_subject.csv",
    "format": {
      "parse": {
        "year": "number",
        "enrolments": "number",
        "female": "number",
        "male": "number",
        "female_share_pct": "number"
      }
    }
  },
  "params": [
    {
      "name": "highlightState",
      "value": "ACT",
      "bind": {
        "input": "select",
        "name": "Highlight state ",
        "options": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "ACT"
        ],
        "labels": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Australian Capital Territory"
        ]
      }
    },
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.group_type === 'subject' && datum.year_level === 'Year 11-12 combined'"
    },
    {
      "lookup": "group",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main//data/stem_lookup.csv"
        },
        "key": "group",
        "fields": [
          "is_stem"
        ]
      }
    },
    {
      "calculate": "datum.is_stem === 'yes' ? 'STEM' : 'Non-STEM'",
      "as": "stem_label"
    },
    {
      "calculate": "datum.year === 2025 ? datum.female_share_pct : null",
      "as": "share2025"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "share2025",
          "as": "sortKey"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "filter": "datum.year === selectedYear"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "female_share_pct",
          "as": "lowest"
        },
        {
          "op": "max",
          "field": "female_share_pct",
          "as": "highest"
        },
        {
          "op": "mean",
          "field": "female_share_pct",
          "as": "average"
        }
      ],
      "groupby": [
        "group"
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "from": 0,
            "to": 50,
            "side": "boys"
          },
          {
            "from": 50,
            "to": 100,
            "side": "girls"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "opacity": 0.1
      },
      "encoding": {
        "x": {
          "field": "from",
          "type": "quantitative"
        },
        "x2": {
          "field": "to"
        },
        "color": {
          "field": "side",
          "type": "nominal",
          "scale": {
            "domain": [
              "boys",
              "girls"
            ],
            "range": [
              "#4a3aa7",
              "#d95f02"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 45,
            "label": "← More boys",
            "align": "right"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#4a3aa7",
        "y": -10
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 55,
            "label": "More girls →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#b34d00",
        "y": -10
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "description": "Reference line",
      "data": {
        "values": [
          {
            "x": 50
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#807e78",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Range line from the lowest to the highest state.",
      "mark": {
        "type": "rule",
        "color": "#c3c2b7",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "sortKey",
            "op": "mean",
            "order": "descending"
          },
          "axis": null,
          "scale": {
            "type": "point",
            "padding": 1.3
          }
        },
        "x": {
          "field": "lowest",
          "type": "quantitative"
        },
        "x2": {
          "field": "highest"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "#fbfaf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "sortKey",
            "op": "mean",
            "order": "descending"
          },
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 12.5,
            "labelColor": "#1d1c1a",
            "labelPadding": 8
          },
          "scale": {
            "padding": 1.3
          }
        },
        "x": {
          "field": "female_share_pct",
          "type": "quantitative",
          "title": "Girls' share of enrolments (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "grid": false
          }
        },
        "size": {
          "condition": {
            "test": "datum.state === highlightState",
            "value": 120
          },
          "value": 55
        },
        "order": {
          "condition": {
            "test": "datum.state === highlightState",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "group",
            "title": "Subject"
          },
          {
            "field": "stem_label",
            "title": "Subject type"
          },
          {
            "field": "female_share_pct",
            "title": "Girls (%)",
            "format": ".1f"
          },
          {
            "field": "enrolments",
            "title": "Enrolments",
            "format": ",.0f"
          }
        ],
        "fill": {
          "condition": {
            "test": "datum.state === highlightState",
            "value": "#1d1c1a"
          },
          "field": "stem_label",
          "type": "nominal",
          "title": "Subject type",
          "scale": {
            "domain": [
              "STEM",
              "Non-STEM"
            ],
            "range": [
              "#45966c",
              "#9e9c95"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolSize": 90,
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.state === highlightState",
            "value": 1
          },
          "value": 0.85
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -9.5,
        "fontSize": 9,
        "fontWeight": 700,
        "color": "#1d1c1a"
      },
      "encoding": {
        "y": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "sortKey",
            "op": "mean",
            "order": "descending"
          },
          "axis": null,
          "scale": {
            "padding": 1.3
          }
        },
        "x": {
          "field": "female_share_pct",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "datum.state === highlightState",
            "field": "state"
          },
          "value": ""
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
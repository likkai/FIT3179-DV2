{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Language's Share of Year 12 Enrolments in 2010 and 2024",
  "title": {
    "text": "How Language Study is Divided Between Languages in 2010 and 2024",
    "subtitle": [""],
    "anchor": "start",
    "fontSize": 17
  },

  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/acara_year12_subject_enrolments.csv",
    "format": {"parse": {"year": "number", "proportion_pct": "number"}}
  },

  "transform": [
    {"filter": "datum.sex === 'All' && (datum.year === 2010 || datum.year === 2024)"},
    {
      "filter": {
        "field": "learning_area",
        "oneOf": [
          "Arabic",
          "Chinese",
          "French",
          "German",
          "Greek",
          "Indonesian",
          "Italian",
          "Japanese",
          "Spanish",
          "Vietnamese"
        ]
      }
    },
    {
      "calculate": "datum.learning_area === 'Other' ? 'Other languages' : datum.learning_area",
      "as": "learning_area"
    },
    {"calculate": "datum.year === 2010 ? datum.proportion_pct : null", "as": "v2010"},
    {"calculate": "datum.year === 2024 ? datum.proportion_pct : null", "as": "v2024"},
    {
      "joinaggregate": [
        {"op": "max", "field": "v2010", "as": "start"},
        {"op": "max", "field": "v2024", "as": "end"}
      ],
      "groupby": ["learning_area"]
    },
    {"calculate": "datum.end - datum.start", "as": "change"},
    {"calculate": "datum.change >= 0 ? 'Gained share' : 'Lost share'", "as": "direction"},
    {"calculate": "toString(datum.year)", "as": "year_label"}
  ],

  "encoding": {
    "y": {
      "field": "learning_area",
      "type": "nominal",
      "sort": {"field": "end", "op": "max", "order": "descending"},
      "axis": {
        "domain": false,
        "title": "Languages",
        "ticks": false,
        "labelFontSize": 12.5,
        "labelColor": "#1d1c1a",
        "labelPadding": 8,
        "grid": true,
        "gridColor": "#efeee9"
      }
    }
  },

  "layer": [
    {
      "description": "Blue if the language gained share, orange if it lost share.",
      "transform": [{"filter": "datum.year === 2024"}],
      "mark": {"type": "rule", "strokeWidth": 3, "strokeCap": "round"},
      "encoding": {
        "x": {"field": "start", "type": "quantitative"},
        "x2": {"field": "end"},
        "color": {
          "field": "direction",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Gained share", "Lost share"], "range": ["#2166ac", "#b35806"]},
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 3
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "stroke": "#fbfaf7",
        "strokeWidth": 2,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "proportion_pct",
          "type": "quantitative",
          "title": "Percentage of Share of Year 12 language enrolments",
          "scale": {"domain": [0, 26]},
          "axis": {"labelExpr": "datum.value + '%'", "grid": false}
        },
        "fill": {
          "field": "year_label",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["2010", "2024"], "range": ["#b9b7ae", "#1d1c1a"]},
          "legend": {"orient": "top", "direction": "horizontal", "symbolType": "circle"}
        },
        "tooltip": [
          {"field": "learning_area", "title": "Language"},
          {"field": "start", "title": "2010 (%)", "format": ".1f"},
          {"field": "end", "title": "2024 (%)", "format": ".1f"},
          {"field": "change", "title": "Change (pp)", "format": "+.1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.year === 2024"},
        {"calculate": "max(datum.start, datum.end)", "as": "label_x"},
        {"calculate": "format(datum.change, '+.1f') + ' pp'", "as": "change_label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 11.5, "color": "#52514e"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative"},
        "text": {"field": "change_label"}
      }
    }
  ]
}

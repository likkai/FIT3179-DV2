{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Subject Changes Driven by Gender",
  "title": {
    "text": "Which Subjects Saw the Greatest Asymmetry in Growth?",
    "anchor": "start",
    "fontSize": 17,
    "subtitle": [
      "Change in male and female enrolments by subject group",
      "Sorted by absolute growth rate difference between genders"
    ]
  },

  "width": "container",
  "height": 440,
  "padding": {"left": 10, "right": 20, "top": 10, "bottom": 10},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/aus_senior_enrolments.csv",
    "format": {
      "parse": {"year": "number", "enrolments": "number", "female": "number", "male": "number"}
    }
  },

  "params": [
    {
      "name": "start_year",
      "value": 2015,
      "bind": {"input": "range", "min": 2015, "max": 2023, "step": 1, "name": "From year "}
    },
    {
      "name": "end_year",
      "value": 2024,
      "bind": {"input": "range", "min": 2016, "max": 2024, "step": 1, "name": "To year "}
    }
  ],

  "transform": [
    {
      "filter": "datum.year_level === 'Year 11-12 combined' && datum.subject_group && isValid(datum.female) && isValid(datum.male) && indexof([\"NSW\", \"VIC\", \"SA\", \"WA\"], datum.state) >= 0 && (datum.year === start_year || datum.year === end_year)"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "female", "as": "female"},
        {"op": "sum", "field": "male", "as": "male"}
      ],
      "groupby": ["state", "year", "subject_group"]
    },
    {"filter": "datum.female + datum.male >= 50"},
    {"calculate": "datum.subject_group", "as": "group"},
    {
      "aggregate": [
        {"op": "sum", "field": "female", "as": "female_students"},
        {"op": "sum", "field": "male", "as": "male_students"}
      ],
      "groupby": ["group", "year"]
    },
    {
      "calculate": "datum.year === start_year ? datum.female_students : null",
      "as": "female_at_start"
    },
    {"calculate": "datum.year === start_year ? datum.male_students : null", "as": "male_at_start"},
    {
      "joinaggregate": [
        {"op": "max", "field": "female_at_start", "as": "female_at_start"},
        {"op": "max", "field": "male_at_start", "as": "male_at_start"}
      ],
      "groupby": ["group"]
    },
    {
      "filter": "datum.year === end_year && isValid(datum.female_at_start) && isValid(datum.male_at_start)"
    },
    {
      "calculate": "(datum.female_students / datum.female_at_start - 1) * 100",
      "as": "female_change_pct"
    },
    {"calculate": "(datum.male_students / datum.male_at_start - 1) * 100", "as": "male_change_pct"},
    {
      "calculate": "datum.female_change_pct * datum.male_change_pct < 0 ? 'Opposite directions' : (datum.female_change_pct >= 0 ? 'Both grew' : 'Both fell')",
      "as": "pattern"
    },
    {"calculate": "datum.female_students + datum.male_students", "as": "students_at_end"},
    {"calculate": "abs(datum.female_change_pct - datum.male_change_pct)", "as": "gap_abs"},
    {"fold": ["female_change_pct", "male_change_pct"], "as": ["gender_key", "change_pct"]},
    {"calculate": "datum.gender_key === 'female_change_pct' ? 'Female' : 'Male'", "as": "gender"},
    {
      "calculate": "datum.gender === 'Female' ? datum.female_students : datum.male_students",
      "as": "gender_students"
    },
    {"joinaggregate": [{"op": "min", "field": "change_pct", "as": "row_min"}], "groupby": ["group"]},
    {
      "calculate": "indexof(['Engineering', 'Business', 'Accounting', 'Mathematics'], datum.group) < 0 ? '' : (round(datum.change_pct) === 0 ? '0' : format(datum.change_pct, '+.0f'))",
      "as": "value_label"
    }
  ],

  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": "Subjects",
      "sort": {"field": "gap_abs", "op": "max", "order": "descending"},
      "axis": {
        "titlePadding": 10,
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "ticks": false,
        "domain": false,
        "grid": false
      }
    }
  },

  "layer": [
    {
      "mark": {"type": "rule", "color": "#1d1c1a", "strokeWidth": 1},
      "encoding": {
        "x": {"datum": 0, "type": "quantitative"},
        "y": {"value": 0},
        "y2": {"value": "height"}
      }
    },
    {
      "mark": {"type": "rule", "color": "#b9b7ae", "strokeWidth": 4},
      "encoding": {
        "x": {"aggregate": "min", "field": "change_pct", "type": "quantitative"},
        "x2": {"aggregate": "max", "field": "change_pct"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "fillOpacity": 0.75,
        "opacity": 1,
        "stroke": "#fbfaf7",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "change_pct",
          "type": "quantitative",
          "title": "Percentage of Change in Enrolments",
          "axis": {"format": "+d", "grid": true, "gridColor": "#eeede8"},
          "scale": {"domain": [-60, 260], "nice": false}
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "title": null,
          "scale": {"domain": ["Female", "Male"], "range": ["#d6619b", "#6b7a1e"]},
          "legend": {"orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "group", "title": "Subject"},
          {"field": "gender", "title": "Gender"},
          {"field": "change_pct", "title": "Change (%)", "format": "+.0f"},
          {"field": "gender_students", "title": "Enrolments", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#1d1c1a",
        "align": {"expr": "datum.change_pct === datum.row_min ? 'right' : 'left'"},
        "dx": {"expr": "datum.change_pct === datum.row_min ? (datum.change_pct > 0 && (abs(datum.change_pct) * width / 320) >= 9 && (abs(datum.change_pct) * width / 320) <= 14 + 7 * length(datum.value_label) ? -((abs(datum.change_pct) * width / 320) + 5) : -11) : (datum.change_pct < 0 && (abs(datum.change_pct) * width / 320) >= 9 && (abs(datum.change_pct) * width / 320) <= 14 + 7 * length(datum.value_label) ? (abs(datum.change_pct) * width / 320) + 5 : 11)"}
      },
      "encoding": {
        "x": {"field": "change_pct", "type": "quantitative"},
        "text": {"field": "value_label"},
        "tooltip": [
          {"field": "group", "title": "Subject"},
          {"field": "gender", "title": "Gender"},
          {"field": "change_pct", "title": "Change (%)", "format": "+.0f"},
          {"field": "gender_students", "title": "Enrolments", "format": ","}
        ]
      }
    }
  ]
}

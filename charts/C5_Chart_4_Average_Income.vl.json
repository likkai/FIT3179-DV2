{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "How Much Do Jobs in Each University Field Pay?",
    "anchor": "start",
    "fontSize": 17,
    "subtitle": ["Average income by state for graduates in selected field"]
  },

  "width": "container",
  "height": 460,
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/ato_individuals_occupation_unit_group_by_state_2023_24.csv",
    "format": {"parse": {"occupation_unit_group": "string"}}
  },

  "params": [
    {
      "name": "selected_field",
      "value": "Engineering and Related Technologies",
      "bind": {
        "input": "select",
        "options": [
          "Information Technology",
          "Engineering and Related Technologies",
          "Natural and Physical Sciences",
          "Architecture and Building",
          "Health",
          "Education",
          "Management and Commerce",
          "Society and Culture",
          "Creative Arts"
        ],
        "name": "University field "
      }
    }
  ],

  "transform": [
    {
      "calculate": "indexof(({'Information Technology': ['26'], 'Engineering and Related Technologies': ['233'], 'Natural and Physical Sciences': ['234'], 'Architecture and Building': ['232'], 'Health': ['25'], 'Education': ['24'], 'Management and Commerce': ['22'], 'Society and Culture': ['27'], 'Creative Arts': ['21']})[selected_field], substring(datum.occupation_unit_group, 0, length(({'Information Technology': '26', 'Engineering and Related Technologies': '233', 'Natural and Physical Sciences': '234', 'Architecture and Building': '232', 'Health': '25', 'Education': '24', 'Management and Commerce': '22', 'Society and Culture': '27', 'Creative Arts': '21'})[selected_field]))) >= 0 ? 'field' : null",
      "as": "row_type"
    },
    {"filter": "isValid(datum.row_type) && datum.state !== 'Overseas'"},
    {"calculate": "toNumber(datum.individuals)", "as": "individuals_number"},
    {"calculate": "toNumber(datum.average_salary_or_wage_income)", "as": "average_salary_number"},
    {"filter": "isFinite(datum.individuals_number) && isFinite(datum.average_salary_number)"},
    {"calculate": "datum.individuals_number * datum.average_salary_number", "as": "salary_total"},
    {
      "aggregate": [
        {"op": "sum", "field": "individuals_number", "as": "individuals_total"},
        {"op": "sum", "field": "salary_total", "as": "salary_total"}
      ],
      "groupby": ["state"]
    },
    {"calculate": "datum.salary_total / datum.individuals_total", "as": "average_income"},
    {
      "calculate": "'$' + format(datum.average_income / 1000, '.0f') + 'k'",
      "as": "average_income_label"
    },
    {"calculate": "format(datum.individuals_total / 1000, '.1~f') + 'k'", "as": "individuals_label"},
    {
      "calculate": "({'Information Technology': 'ICT Professionals', 'Engineering and Related Technologies': 'Engineering Professionals', 'Natural and Physical Sciences': 'Natural and Physical Science Professionals', 'Architecture and Building': 'Architects, Designers, Planners and Surveyors', 'Health': 'Health Professionals', 'Education': 'Education Professionals', 'Management and Commerce': 'Business, Human Resource and Marketing Professionals', 'Society and Culture': 'Legal, Social and Welfare Professionals', 'Creative Arts': 'Arts and Media Professionals'})[selected_field]",
      "as": "occupation_group"
    },
    {
      "lookup": "state",
      "from": {
        "data": {"url": "data/aus_states_location.csv"},
        "key": "state",
        "fields": ["state_name", "capital_lon", "capital_lat", "symbol_lon", "symbol_lat"]
      }
    }
  ],

  "layer": [
    {
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "australia_states.topojson",
              "format": {"type": "topojson", "feature": "states"}
            },
            "key": "properties.state"
          },
          "as": "geo"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#fbfaf7", "strokeWidth": 1.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "average_income",
          "type": "quantitative",
          "title": "Average income",
          "scale": {
            "domain": [50000, 160000],
            "interpolate": "lab",
            "range": ["#f7f5ee", "#a8325e"],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "gradientThickness": 10,
            "titleOrient": "left",
            "titlePadding": 10,
            "format": "$,.0f",
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "occupation_group", "title": "Matching occupations"},
          {"field": "average_income", "title": "Average salary", "format": "$,.0f"},
          {"field": "individuals_label", "title": "People in these occupations"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.state === 'ACT'"},
        {"calculate": "157.5", "as": "magnifier_lon"},
        {"calculate": "-37", "as": "magnifier_lat"}
      ],
      "mark": {"type": "rule", "color": "#807e78", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "capital_lon", "type": "quantitative"},
        "latitude": {"field": "capital_lat", "type": "quantitative"},
        "longitude2": {"field": "magnifier_lon"},
        "latitude2": {"field": "magnifier_lat"}
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "baseline": "middle",
        "dy": -7,
        "align": {"expr": "datum.state === 'ACT' ? 'left' : 'center'"},
        "dx": {"expr": "datum.state === 'ACT' ? 5 : 0"}
      },
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "occupation_group", "title": "Matching occupations"},
          {"field": "average_income", "title": "Average salary", "format": "$,.0f"},
          {"field": "individuals_label", "title": "People in these occupations"}
        ],
        "text": {"field": "state"},
        "color": {
          "condition": {
            "test": "datum.state !== 'ACT' && datum.average_income >= 105000",
            "value": "#ffffff"
          },
          "value": "#1d1c1a"
        }
      },
      "transform": [
        {
          "calculate": "datum.state === 'ACT' ? 157.5 : (datum.state === 'VIC' ? 142.8 : datum.symbol_lon)",
          "as": "label_lon"
        },
        {
          "calculate": "datum.state === 'ACT' ? -37 : (datum.state === 'VIC' ? -36.9 : datum.symbol_lat)",
          "as": "label_lat"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "baseline": "middle",
        "dy": 7,
        "align": {"expr": "datum.state === 'ACT' ? 'left' : 'center'"},
        "dx": {"expr": "datum.state === 'ACT' ? 5 : 0"}
      },
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "occupation_group", "title": "Matching occupations"},
          {"field": "average_income", "title": "Average salary", "format": "$,.0f"},
          {"field": "individuals_label", "title": "People in these occupations"}
        ],
        "text": {"field": "average_income_label"},
        "color": {
          "condition": {
            "test": "datum.state !== 'ACT' && datum.average_income >= 105000",
            "value": "#ffffff"
          },
          "value": "#1d1c1a"
        }
      },
      "transform": [
        {
          "calculate": "datum.state === 'ACT' ? 157.5 : (datum.state === 'VIC' ? 142.8 : datum.symbol_lon)",
          "as": "label_lon"
        },
        {
          "calculate": "datum.state === 'ACT' ? -37 : (datum.state === 'VIC' ? -36.9 : datum.symbol_lat)",
          "as": "label_lat"
        }
      ]
    }
  ]
}

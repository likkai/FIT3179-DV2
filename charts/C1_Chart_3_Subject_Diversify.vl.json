{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in HHI of Year 12 enrolments",
    "subtitle": [
      "HHI = Herfindahl-Hirschman Index",
      "Below 0 = Less concentrated; Above 0 = More concentrated",
      "2015 HHI = 1,546"
    ],
    "anchor": "start",
    "fontSize": 17,
    "subtitleColor": "#52514e",
    "subtitleFontSize": 12,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 6,
    "offset": 16
  },

  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/acara_year12_subject_enrolments.csv",
    "format": {"type": "csv", "parse": {"year": "number", "proportion_pct": "number"}}
  },

  "transform": [
    {"filter": "datum.sex === 'All' && datum.year >= 2015"},
    {
      "filter": {
        "field": "learning_area",
        "oneOf": [
          "English",
          "Mathematics",
          "Society and Environment",
          "Science",
          "Arts",
          "Languages other than English",
          "Technology",
          "Health and Physical Education"
        ]
      }
    },
    {
      "joinaggregate": [{"op": "sum", "field": "proportion_pct", "as": "total"}],
      "groupby": ["year"]
    },
    {"calculate": "pow(datum.proportion_pct / datum.total, 2) * 10000", "as": "sqr"},
    {"aggregate": [{"op": "sum", "field": "sqr", "as": "hhi"}], "groupby": ["year"]},
    {
      "window": [{"op": "first_value", "field": "hhi", "as": "hhi_2015"}],
      "sort": [{"field": "year", "order": "ascending"}]
    },
    {"calculate": "datum.hhi - datum.hhi_2015", "as": "change"},
    {"joinaggregate": [{"op": "min", "field": "change", "as": "min_change"}]}
  ],

  "layer": [
    {
      "data": {"values": [{}]},
      "mark": {"type": "rule", "color": "#52514e", "strokeWidth": 1},
      "encoding": {"y": {"datum": 0}}
    },
    {
      "mark": {
        "type": "line",
        "color": "#44546a",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "fill": "#44546a",
          "stroke": "white",
          "strokeWidth": 1.5,
          "size": 70
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "title": "Year",
          "type": "quantitative",
          "scale": {"domain": [2014.5, 2024.5], "nice": false},
          "axis": {
            "values": [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
            "format": "d",
            "grid": false,
            "labelAngle": 0,
            "ticks": false,
            "labelPadding": 8
          }
        },
        "y": {
          "field": "change",
          "type": "quantitative",
          "scale": {"domain": [-25, 100], "nice": false},
          "axis": {
            "values": [-25, 0, 25, 50, 75, 100],
            "labelExpr": "datum.value > 0 ? '+' + datum.value : datum.value < 0 ? '−' + abs(datum.value) : '0'",
            "title": "HHI points compared to 2015",
            "grid": true,
            "domain": false,
            "ticks": false
          }
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "hhi", "type": "quantitative", "title": "HHI", "format": ",.0f"},
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change since 2015",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.year === 2024 || datum.year === 2021 || datum.year === 2020"},
        {
          "calculate": "datum.change > 0 ? '+' + format(datum.change, '.1f') : '−' + format(abs(datum.change), '.1f')",
          "as": "label"
        },
        {"calculate": "datum.change + (datum.year === 2020 ? 10 : 7)", "as": "label_y"}
      ],
      "mark": {"type": "text", "color": "#52514e", "fontSize": 12, "baseline": "middle"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "label_y", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dy": 42,
        "color": "#898781",
        "fontSize": 10,
        "lineHeight": 15,
        "text": [
          "Learning areas included: English, Mathematics, Society and Environment, Science,",
          "Technology, Health and Physical Education, Arts, Languages other than English."
        ]
      },
      "encoding": {"x": {"value": 0}, "y": {"value": "height"}}
    }
  ],

  "config": {"view": {"stroke": null}, "font": "Helvetica, Arial, sans-serif"}
}

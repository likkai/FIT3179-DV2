{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How Each State's Subject Mix Compares with the National Average",
  "title": {
    "text": "How Each State's Subject Mix Compares with the National Average",
    "subtitle": [
      "Percentage points above (blue) or below (red) the 8-state average"
    ],
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/national_learning_area.csv",
    "format": {
      "parse": {
        "year": "number",
        "enrolments": "number",
        "state_total_enrolments": "number",
        "share_of_all_pct": "number",
        "share_excl_vocational_other_pct": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year"
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year_level === 'Year 11-12 combined' && datum.year === selectedYear && datum.learning_area !== 'Vocational and Other'"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "share_excl_vocational_other_pct",
          "as": "average"
        }
      ],
      "groupby": [
        "learning_area"
      ]
    },
    {
      "calculate": "datum.share_excl_vocational_other_pct - datum.average",
      "as": "difference"
    }
  ],
  "width": {
    "step": 50
  },
  "height": {
    "step": 42
  },
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelColor": "#1d1c1a",
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "learning_area",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "average",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 12.5,
        "labelColor": "#1d1c1a",
        "labelLimit": 200,
        "labelExpr": "{'Humanities and Social Sciences': 'Humanities & Social Sci.', 'Technology and Business': 'Technology & Business', 'Health and Physical Education': 'Health & PE'}[datum.label] || datum.label",
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "rowHover",
          "select": {
            "type": "point",
            "fields": [
              "learning_area"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "stroke": "#fbfaf7",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "difference",
          "type": "quantitative",
          "title": "Compared with average (pp)",
          "scale": {
            "scheme": "redblue",
            "domainMid": 0
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "format": "+.0f",
            "values": [
              -6,
              -3,
              0,
              3,
              6
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "learning_area",
            "title": "Learning area"
          },
          {
            "field": "share_excl_vocational_other_pct",
            "title": "State share (%)",
            "format": ".1f"
          },
          {
            "field": "average",
            "title": "8-state average (%)",
            "format": ".1f"
          },
          {
            "field": "difference",
            "title": "Difference (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "share_excl_vocational_other_pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "abs(datum.difference) > 3.5",
            "value": "#ffffff"
          },
          "value": "#1d1c1a"
        }
      }
    }
  ]
}

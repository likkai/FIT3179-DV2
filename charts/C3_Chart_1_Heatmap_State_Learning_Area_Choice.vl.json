{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How Each State's Subject Mix Compares with the National Average",
  "title": {
    "text": "How Subject Choices Differ Across States",
    "fontSize": 17,
    "subtitle": ["pp = percentage points"],
    "anchor": "start"
  },

  "data": {
    "url": "data/aus_senior_enrolments.csv",
    "format": {"parse": {"year": "number", "enrolments": "number"}}
  },

  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {"input": "range", "min": 2021, "max": 2025, "step": 1, "name": "Year"}
    }
  ],

  "transform": [
    {"filter": "datum.year_level === 'Year 11-12 combined' && datum.year === selectedYear"},
    {
      "calculate": "datum.learning_area === 'Vocational and Other' ? 0 : datum.enrolments",
      "as": "enrolments_excl_vocational_other"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "enrolments_excl_vocational_other",
          "as": "state_total_excl_vocational_other"
        }
      ],
      "groupby": ["state"]
    },
    {"filter": "datum.learning_area !== 'Vocational and Other'"},
    {
      "aggregate": [
        {"op": "sum", "field": "enrolments", "as": "learning_area_enrolments"},
        {
          "op": "max",
          "field": "state_total_excl_vocational_other",
          "as": "state_total_excl_vocational_other"
        }
      ],
      "groupby": ["state", "state_name", "learning_area"]
    },
    {
      "calculate": "datum.learning_area_enrolments / datum.state_total_excl_vocational_other * 100",
      "as": "share_excl_vocational_other_pct"
    },
    {
      "joinaggregate": [{"op": "mean", "field": "share_excl_vocational_other_pct", "as": "average"}],
      "groupby": ["learning_area"]
    },
    {"calculate": "datum.share_excl_vocational_other_pct - datum.average", "as": "difference"},
    {
      "calculate": "datum.state === 'NSW' ? [datum.state, 'Average'] : [datum.state]",
      "as": "col_pair"
    },
    {"flatten": ["col_pair"], "as": ["col"]},
    {"calculate": "datum.col === 'Average' ? 'All 8 states' : datum.state_name", "as": "tip_state"},
    {
      "calculate": "datum.col === 'Average' ? format(datum.average, '.1f') : format(datum.share_excl_vocational_other_pct, '.1f')",
      "as": "tip_share"
    },
    {
      "calculate": "datum.col === 'Average' ? '–' : (round(datum.difference * 10) === 0 ? '0.0' : format(datum.difference, '+.1f'))",
      "as": "tip_diff"
    },
    {
      "calculate": "datum.col === 'Average' ? format(datum.average, '.1f') + '%' : (round(datum.difference * 10) === 0 ? '0.0' : format(datum.difference, '+.1f'))",
      "as": "cell_label"
    }
  ],

  "width": {"step": 50},
  "height": {"step": 42},
  "encoding": {
    "x": {
      "field": "col",
      "type": "nominal",
      "title": null,
      "sort": ["Average", "NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 700,
        "labelColor": "#1d1c1a",
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "learning_area",
      "type": "nominal",
      "title": null,
      "sort": {"field": "average", "op": "mean", "order": "descending"},
      "axis": {
        "labelFontSize": 12.5,
        "labelColor": "#1d1c1a",
        "labelLimit": 200,
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    }
  },

  "layer": [
    {
      "params": [
        {
          "name": "rowHover",
          "select": {
            "type": "point",
            "fields": ["learning_area"],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "rect", "cornerRadius": 3, "stroke": "#fbfaf7", "strokeWidth": 2},
      "encoding": {
        "color": {
          "condition": {"test": "datum.col === 'Average'", "value": "#e1dfd5"},
          "field": "difference",
          "type": "quantitative",
          "title": "Compared with average (pp)",
          "titleLimit": 300,
          "scale": {"domain": [-6.5, 0, 6.5], "interpolate": "lab", "range": ["#b35806", "#f7f5ee", "#2166ac"], "clamp": true},
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "format": "+.0f",
            "values": [-6, -3, 0, 3, 6]
          }
        },
        "tooltip": [
          {"field": "tip_state", "title": "State"},
          {"field": "learning_area", "title": "Learning area"},
          {"field": "tip_share", "title": "State share (%)"},
          {"field": "tip_diff", "title": "Difference (pp)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12, "fontWeight": 600},
      "encoding": {
        "text": {"field": "cell_label", "type": "nominal"},
        "color": {
          "condition": [
            {"test": "datum.col === 'Average'", "value": "#5f5d56"},
            {"test": "abs(datum.difference) > 3.5", "value": "#ffffff"}
          ],
          "value": "#1d1c1a"
        }
      }
    }
  ]
}

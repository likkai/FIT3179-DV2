{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How Do Learning Area Choices Divide Among Genders?",
  "title": {
    "text": "How Do Learning Area Choices Divide Among Genders?",
    "fontSize": 19,
    "anchor": "start",
    "subtitle": ["Change in Year 12 enrolment share between male and female", "pp = percentage points"]
  },

  "data": {
    "url": "data/acara_year12_subject_enrolments.csv",
    "format": {"parse": {"year": "number", "proportion_pct": "number"}}
  },

  "params": [
    {
      "name": "selected_year",
      "value": 2024,
      "bind": {"input": "range", "min": 2015, "max": 2024, "step": 1, "name": "Year "}
    }
  ],

  "transform": [
    {"filter": "datum.year === selected_year && datum.sex !== 'All'"},
    {
      "filter": {
        "field": "learning_area",
        "oneOf": [
          "English",
          "Mathematics",
          "Science",
          "Society and Environment",
          "Arts",
          "Technology",
          "Health and Physical Education",
          "Languages other than English"
        ]
      }
    },
    {"pivot": "sex", "value": "proportion_pct", "groupby": ["learning_area"]},
    {"calculate": "datum.Female - datum.Male", "as": "gap"},
    {"calculate": "abs(datum.gap)", "as": "abs_gap"},
    {
      "calculate": "(datum.gap > 0 ? 'Girls +' : 'Boys +') + format(abs(datum.gap), '.1f') + ' pp'",
      "as": "gap_label"
    }
  ],

  "spacing": 0,
  "bounds": "flush",
  "hconcat": [
    {
      "title": {
        "text": "Boys",
        "anchor": "end",
        "fontSize": 16,
        "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
        "fontWeight": 700,
        "color": "#6b7a1e"
      },
      "width": 255,
      "height": {"step": 40},
      "encoding": {
        "y": {
          "field": "learning_area",
          "type": "nominal",
          "sort": {"field": "abs_gap", "order": "descending"},
          "axis": null
        },
        "x": {
          "field": "Male",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 100], "reverse": true},
          "axis": {"values": [0, 25, 50, 75, 100], "labelExpr": "datum.value + '%'", "grid": true}
        },
        "tooltip": [
          {"field": "learning_area", "title": "Learning area"},
          {"field": "Male", "title": "Boys (%)", "format": ".1f"},
          {"field": "Female", "title": "Girls (%)", "format": ".1f"},
          {"field": "gap_label", "title": "Gap"}
        ]
      },
      "layer": [
        {"mark": {"type": "bar", "color": "#6b7a1e", "size": 22, "cornerRadiusEnd": 4}},
        {
          "mark": {"type": "text", "align": "right", "dx": -5, "fontSize": 14, "color": "#1d1c1a"},
          "encoding": {"text": {"field": "Male", "format": ".1f"}}
        }
      ]
    },
    {
      "width": 230,
      "height": {"step": 40},
      "encoding": {
        "y": {
          "field": "learning_area",
          "type": "nominal",
          "sort": {"field": "abs_gap", "order": "descending"},
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {"type": "text", "dy": -8, "fontSize": 14, "fontWeight": 600, "color": "#1d1c1a"},
          "encoding": {"x": {"value": 115}, "text": {"field": "learning_area"}}
        },
        {
          "mark": {"type": "text", "dy": 10, "fontSize": 14, "color": "#807e78"},
          "encoding": {"x": {"value": 115}, "text": {"field": "gap_label"}}
        }
      ]
    },
    {
      "title": {
        "text": "Girls",
        "anchor": "start",
        "fontSize": 16,
        "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
        "fontWeight": 700,
        "color": "#d6619b"
      },
      "width": 255,
      "height": {"step": 40},
      "encoding": {
        "y": {
          "field": "learning_area",
          "type": "nominal",
          "sort": {"field": "abs_gap", "order": "descending"},
          "axis": null
        },
        "x": {
          "field": "Female",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 100]},
          "axis": {"values": [0, 25, 50, 75, 100], "labelExpr": "datum.value + '%'", "grid": true}
        },
        "tooltip": [
          {"field": "learning_area", "title": "Learning area"},
          {"field": "Female", "title": "Girls (%)", "format": ".1f"},
          {"field": "Male", "title": "Boys (%)", "format": ".1f"},
          {"field": "gap_label", "title": "Gap"}
        ]
      },
      "layer": [
        {"mark": {"type": "bar", "color": "#d6619b", "size": 22, "cornerRadiusEnd": 4}},
        {
          "mark": {"type": "text", "align": "left", "dx": 5, "fontSize": 14, "color": "#1d1c1a"},
          "encoding": {"text": {"field": "Female", "format": ".1f"}}
        }
      ]
    }
  ]
}

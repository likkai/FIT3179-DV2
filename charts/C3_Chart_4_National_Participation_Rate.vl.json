{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Which States Take Up Specific Subjects Most?",
  "title": {
    "text": "Which States Take Up Specific Subjects Most?",
    "fontSize": 19,
    "anchor": "start",
    "subtitle": [
      "State areas scaled to senior student numbers",
      "Percentage in label is subject's share of that state's enrolments",
      "Data from 2021 to 2025"
    ]
  },

  "width": "container",
  "height": 440,
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "identity", "reflectY": true},
  "data": {
    "url": "data/aus_senior_enrolments.csv",
    "format": {"parse": {"year": "number", "enrolments": "number"}}
  },

  "params": [
    {
      "name": "selected_subject",
      "value": "Business",
      "bind": {
        "input": "select",
        "options": [
          "Biology",
          "Business",
          "Chemistry",
          "Community and Family Studies",
          "Computing and IT",
          "Design and Technology",
          "Economics",
          "English",
          "Food and Nutrition",
          "Health",
          "Legal Studies",
          "Mathematics",
          "Modern History",
          "Music",
          "Outdoor Education",
          "Physical Education",
          "Physics",
          "Psychology",
          "Science (general)",
          "Sociology and Society and Culture",
          "Studies of Religion",
          "Visual Arts"
        ],
        "name": "Subject "
      }
    },
    {
      "name": "selected_year",
      "value": 2025,
      "bind": {"input": "range", "min": 2021, "max": 2025, "step": 1, "name": "Year "}
    }
  ],

  "transform": [
    {
      "filter": "datum.year_level === 'Year 11-12 combined' && datum.learning_area !== 'Vocational and Other' && datum.year === selected_year"
    },
    {
      "joinaggregate": [{"op": "sum", "field": "enrolments", "as": "state_total_enrolments"}],
      "groupby": ["state"]
    },
    {"filter": "datum.subject === selected_subject"},
    {
      "aggregate": [
        {"op": "sum", "field": "enrolments", "as": "subject_enrolments"},
        {"op": "max", "field": "state_total_enrolments", "as": "state_total_enrolments"}
      ],
      "groupby": ["state"]
    },
    {
      "calculate": "datum.subject_enrolments / datum.state_total_enrolments * 100",
      "as": "share_of_state_enrolments_pct"
    },
    {
      "impute": "share_of_state_enrolments_pct",
      "key": "state",
      "keyvals": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
      "value": null
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/aus_states_location.csv"
        },
        "key": "state",
        "fields": ["state_name", "symbol_lon", "symbol_lat"]
      }
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "share_of_state_enrolments_pct",
          "as": "average_share_across_states_pct"
        }
      ]
    },
    {
      "calculate": "isValid(datum.share_of_state_enrolments_pct) ? datum.share_of_state_enrolments_pct / datum.average_share_across_states_pct * 100 : null",
      "as": "uptake_index"
    },
    {"calculate": "datum.state_name + '|' + selected_year", "as": "state_year_key"},
    {
      "calculate": "isValid(datum.uptake_index) ? format(datum.share_of_state_enrolments_pct, '.1f') + '%' : 'No data'",
      "as": "share_text"
    },
    {
      "calculate": "isValid(datum.uptake_index) ? format(datum.share_of_state_enrolments_pct, '.1f') + '%' : 'No data'",
      "as": "value_label"
    },
    {
      "lookup": "state_year_key",
      "from": {
        "data": {
          "url": "aus_states_noncontiguous.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "key": "properties.state_year"
      },
      "as": "geo"
    },
    {"calculate": "datum.geo.properties.senior_students", "as": "students_all_number"},
    {
      "calculate": "datum.state === 'NSW' ? datum.geo.properties.senior_students_government : datum.geo.properties.senior_students",
      "as": "senior_students_counted"
    },
    {
      "calculate": "isValid(datum.subject_enrolments) ? datum.subject_enrolments / datum.senior_students_counted * 100 : null",
      "as": "enrolments_per_100_students"
    },
    {"calculate": "datum.geo.properties.label_x", "as": "label_x"},
    {"calculate": "datum.geo.properties.label_y", "as": "label_y"}
  ],

  "layer": [
    {
      "mark": {"type": "geoshape", "stroke": "#fbfaf7", "strokeWidth": 1.2, "invalid": null},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "condition": {"test": "!isValid(datum.uptake_index)", "value": "#d9d7cf"},
          "field": "uptake_index",
          "type": "quantitative",
          "scale": {
            "domain": [50, 100, 150],
            "interpolate": "lab", "range": ["#b35806", "#f7f5ee", "#2166ac"],
            "clamp": true
          },
          "legend": {
            "title": ["Relative popularity", "(100 = average of states)"],
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "gradientLength": 160
          }
        },
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "students_all_number", "title": "Senior students", "format": ",.0f"},
          {"field": "share_text", "title": "Share of state enrolments: "},
          {"field": "uptake_index", "title": "Relative popularity", "format": ".0f"},
          {
            "field": "enrolments_per_100_students",
            "title": "Enrolments per 100 senior students",
            "format": ".1f"
          },
          {"field": "subject_enrolments", "title": "Subject enrolments", "format": ",.0f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.students_all_number >= 30000"},
        {"calculate": "datum.state + ' ' + datum.value_label", "as": "label_text"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "dx": {"expr": "datum.state === 'QLD' ? -6 : (datum.state === 'SA' || datum.state === 'WA' ? -2 : 0)"},
        "dy": {"expr": "datum.state === 'SA' ? -4 : (datum.state === 'VIC' ? 5 : 0)"}
      },
      "encoding": {
        "longitude": {"field": "label_x", "type": "quantitative"},
        "latitude": {"field": "label_y", "type": "quantitative"},
        "text": {"field": "label_text"},
        "color": {
          "condition": {
            "test": "isValid(datum.uptake_index) && (datum.uptake_index <= 62 || datum.uptake_index >= 138)",
            "value": "#ffffff"
          },
          "value": "#1d1c1a"
        },
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "students_all_number", "title": "Senior students", "format": ",.0f"},
          {"field": "share_text", "title": "Share of state enrolments: "},
          {"field": "uptake_index", "title": "Relative popularity", "format": ".0f"},
          {
            "field": "enrolments_per_100_students",
            "title": "Enrolments per 100 senior students",
            "format": ".1f"
          },
          {"field": "subject_enrolments", "title": "Subject enrolments", "format": ",.0f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.students_all_number < 30000"},
        {"calculate": "datum.state + ' ' + datum.value_label", "as": "label_text"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1d1c1a",
        "align": "left",
        "dx": {"expr": "datum.state === 'TAS' ? 24 : (datum.state === 'ACT' ? 22 : 12)"}
      },
      "encoding": {
        "longitude": {"field": "label_x", "type": "quantitative"},
        "latitude": {"field": "label_y", "type": "quantitative"},
        "text": {"field": "label_text"},
        "tooltip": [
          {"field": "state_name", "title": "State"},
          {"field": "students_all_number", "title": "Senior students", "format": ",.0f"},
          {"field": "share_text", "title": "Share of state enrolments: "},
          {"field": "uptake_index", "title": "Relative popularity", "format": ".0f"},
          {
            "field": "enrolments_per_100_students",
            "title": "Enrolments per 100 senior students",
            "format": ".1f"
          },
          {"field": "subject_enrolments", "title": "Subject enrolments", "format": ",.0f"}
        ]
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How Has the Learning Area Gender Gap Evolved Over Time?",
  "title": {
    "text": "How Has the Learning Area Gender Gap Evolved Over Time?",
    "fontSize": 19,
    "anchor": "start",
    "subtitle": [
      "Female share shift from gender balance (pp = percentage points)",
      "Northern Territory excluded because no gender data"
    ]
  },

  "width": "container",
  "height": 460,
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/aus_senior_enrolments.csv",
    "format": {
      "parse": {"year": "number", "enrolments": "number", "female": "number", "male": "number"}
    }
  },

  "params": [
    {
      "name": "state_choice",
      "value": "NSW, VIC, SA and WA (full series)",
      "bind": {
        "input": "select",
        "options": [
          "NSW, VIC, SA and WA (full series)",
          "All states (coverage grows over time)",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "ACT"
        ],
        "name": "States "
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.year_level === 'Year 11-12 combined' && datum.learning_area !== 'Vocational and Other' && isValid(datum.female) && isValid(datum.male) && datum.year >= 2015 && datum.year <= 2024"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "female", "as": "female"},
        {"op": "sum", "field": "male", "as": "male"}
      ],
      "groupby": ["state", "year", "learning_area"]
    },
    {"filter": "datum.female + datum.male >= 50"},
    {"calculate": "datum.learning_area === 'The Arts' ? 'Arts' : datum.learning_area", "as": "group"},
    {
      "filter": "state_choice === 'All states (coverage grows over time)' || (state_choice === 'NSW, VIC, SA and WA (full series)' && indexof(['NSW', 'VIC', 'SA', 'WA'], datum.state) >= 0) || datum.state === state_choice"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "female", "as": "female_students"},
        {"op": "sum", "field": "male", "as": "male_students"},
        {"op": "distinct", "field": "state", "as": "states_counted"}
      ],
      "groupby": ["group", "year"]
    },
    {
      "calculate": "datum.female_students / (datum.female_students + datum.male_students) * 100 - 50",
      "as": "gap_from_balance_pp"
    },
    {
      "calculate": "datum.female_students / (datum.female_students + datum.male_students) * 100",
      "as": "female_share_pct"
    },
    {
      "calculate": "round(datum.gap_from_balance_pp) === 0 ? '0' : format(datum.gap_from_balance_pp, '+.0f')",
      "as": "gap_label"
    }
  ],

  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "ticks": false,
        "domain": false,
        "orient": "top"
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "title": "Learning Area",
      "sort": {"field": "gap_from_balance_pp", "op": "mean", "order": "descending"},
      "axis": {
        "titlePadding": 20,
        "labelFontSize": 14,
        "labelFontWeight": 600,
        "ticks": false,
        "domain": false,
        "labelOffset": {
          "condition": {
            "test": "indexof(['Health and Physical Education', 'Humanities and Social Sciences', 'Technology and Business'], datum.value) >= 0",
            "value": -8
          },
          "value": 0
        },
        "labelExpr": "({'Health and Physical Education': ['Health and', 'Physical Education'], 'Humanities and Social Sciences': ['Humanities and', 'Social Sciences'], 'Technology and Business': ['Technology and', 'Business']})[datum.label] || datum.label"
      }
    }
  },

  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#fbfaf7", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "gap_from_balance_pp",
          "type": "quantitative",
          "title": "Female deviation from parity (pp)",
          "scale": {
            "domain": [-25, 0, 25],
            "interpolate": "lab", "range": ["#6b7a1e", "#f7f5ee", "#d6619b"],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": "+d",
            "titleFontSize": 13,
            "titleLimit": 400,
            "labelFontSize": 11,
            "gradientLength": 200
          }
        },
        "tooltip": [
          {"field": "group", "title": "Learning area"},
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "female_share_pct", "title": "Female share of enrolments (%)", "format": ".1f"},
          {"field": "gap_from_balance_pp", "title": "Female share minus 50 (pp)", "format": "+.1f"},
          {"field": "states_counted", "title": "States counted"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 14, "fontWeight": 600},
      "encoding": {
        "text": {"field": "gap_label"},
        "tooltip": [
          {"field": "group", "title": "Learning area"},
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "female_share_pct", "title": "Female share of enrolments (%)", "format": ".1f"},
          {"field": "gap_from_balance_pp", "title": "Female share minus 50 (pp)", "format": "+.1f"},
          {"field": "states_counted", "title": "States counted"}
        ],
        "color": {
          "condition": {"test": "abs(datum.gap_from_balance_pp) >= 20", "value": "#ffffff"},
          "value": "#1d1c1a"
        }
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Popularity of Each Learning Area by State",
  "title": {
    "text": "Popularity of Each Learning Area by State",
    "subtitle": [
      "Vocational and other courses are excluded as",
      "some states count extra courses that others do not."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "learningArea",
      "value": "Humanities and Social Sciences",
      "bind": {
        "input": "select",
        "name": "Learning area ",
        "options": [
          "English",
          "Mathematics",
          "Science",
          "Humanities and Social Sciences",
          "The Arts",
          "Technology and Business",
          "Health and Physical Education",
          "Languages"
        ]
      }
    },
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e7e1",
        "stroke": "#fbfaf7",
        "strokeWidth": 1
      }
    },
    {
      "description": "Choropleth fill for the selected learning area and year.",
      "data": {
        "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/national_learning_area.csv",
        "format": {
          "parse": {
            "year": "number",
            "enrolments": "number",
            "state_total_enrolments": "number",
            "share_of_all_pct": "number",
            "share_excl_vocational_other_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_level === 'Year 11-12 combined' && datum.learning_area === learningArea && datum.year === selectedYear"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "share_excl_vocational_other_pct",
              "order": "descending"
            }
          ]
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.state_name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fbfaf7",
        "strokeWidth": 1.2
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share_excl_vocational_other_pct",
          "type": "quantitative",
          "title": "Percentage of enrolments",
          "scale": {
            "type": "linear",
            "scheme": {
              "name": "blues"
            },
            "zero": false,
            "nice": true
          },
          "legend": {
            "type": "gradient",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 180,
            "format": ".1f"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "learning_area",
            "title": "Learning area"
          },
          {
            "field": "share_excl_vocational_other_pct",
            "title": "Share of enrolments (%)",
            "format": ".1f"
          },
          {
            "field": "rank",
            "title": "Rank across 8 states"
          },
          {
            "field": "year",
            "title": "Year"
          }
        ]
      }
    },
    {
      "description": "Invisible: feeds all year data into the colour scale so colour scale stay the same as the year slider moves.",
      "data": {
        "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/national_learning_area.csv",
        "format": {
          "parse": {
            "year": "number",
            "enrolments": "number",
            "state_total_enrolments": "number",
            "share_of_all_pct": "number",
            "share_excl_vocational_other_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_level === 'Year 11-12 combined' && datum.learning_area === learningArea && datum.year >= 2021"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0
      },
      "encoding": {
        "color": {
          "field": "share_excl_vocational_other_pct",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "State code and value, white text on dark fills.",
      "data": {
        "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/national_learning_area.csv",
        "format": {
          "parse": {
            "year": "number",
            "enrolments": "number",
            "state_total_enrolments": "number",
            "share_of_all_pct": "number",
            "share_excl_vocational_other_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year_level === 'Year 11-12 combined' && datum.learning_area === learningArea && datum.year >= 2021"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "share_excl_vocational_other_pct",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "share_excl_vocational_other_pct",
              "as": "hi"
            }
          ]
        },
        {
          "filter": "datum.year === selectedYear"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/likkai/FIT3179-DV2/refs/heads/main/data/aus_states_location.csv",
              "format": {
                "parse": {
                  "capital_lon": "number",
                  "capital_lat": "number",
                  "symbol_lon": "number",
                  "symbol_lat": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "symbol_lon",
              "symbol_lat"
            ]
          }
        },
        {
          "calculate": "datum.state + ' ' + format(datum.share_excl_vocational_other_pct, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "symbol_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "symbol_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.state !== 'ACT' && datum.state !== 'TAS' && datum.share_excl_vocational_other_pct >= datum.lo + 0.6 * (datum.hi - datum.lo)",
            "value": "#ffffff"
          },
          "value": "#1d1c1a"
        }
      }
    }
  ]
}